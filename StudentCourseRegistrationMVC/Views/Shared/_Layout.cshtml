<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Student Course Registration</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container nav-wrap">
            <a class="brand" asp-controller="Home" asp-action="Index">Campus<span>Connect</span></a>
            <nav>
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Student" asp-action="Index">Student List</a>
                <a class="nav-button" asp-controller="Student" asp-action="Create">Register Student</a>
            </nav>
        </div>
    </header>

    <main class="container main-content">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">Student Course Registration System · ASP.NET Core MVC · .NET 8</div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
